function swordLv()
{
   if(_root.sword == 0)
   {
      gotoAndStop("一级");
   }
   if(_root.sowrd == 1)
   {
      gotoAndStop("二级");
   }
   if(_root.sowrd == 2)
   {
      gotoAndStop("三级");
   }
   if(_root.sowrd == 3)
   {
      gotoAndStop("四级");
   }
   if(_root.sowrd == 4)
   {
      gotoAndStop("五级");
   }
   if(_root.sowrd == 5)
   {
      gotoAndStop("六级");
   }
}
swordLv();
