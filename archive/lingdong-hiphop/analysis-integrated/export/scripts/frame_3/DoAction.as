function bgm(who)
{
   stopAllSounds();
   _root.mp3.gotoAndPlay(who);
}
function keyBack()
{
   _root.ll = 0;
   _root.rr = 0;
   _root.uu = 0;
   _root.dd = 0;
   _root.gg = 0;
}
function gameBack()
{
   _root.game._x = _root.gameX;
   _root.game._y = _root.gameY;
   _root.game._width = _root.gameW;
   _root.game._height = _root.gameH;
   _root.game._xscale = _root.gameXS;
   _root.game._yscale = _root.gameYS;
   _quality = _root.gameQ;
}
function enemyLoad(n, x, y)
{
   game.attachMovie(n,"enemy" + _root.mcID,_root.mcID++);
   game["enemy" + _root.mcID].id = _root.mcID;
   game["enemy" + _root.mcID]._x = x;
   game["enemy" + _root.mcID]._y = y;
}
